    "blur": {
      "sigma": [
        0.5,
        1.0
      ],
      "mode": "reflect",
      "truncate": 4.0,
      "conversao": "arredondamento para inteiro mais proximo, uint8"
    },
    "entrada": "RGB 32x32"
  }
}
