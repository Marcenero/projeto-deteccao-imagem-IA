{
  "cenarios": [
    "original",
    "jpeg_75",
    "jpeg_30",
    "resize_75",
    "resize_50",
    "blur_05",
    "blur_10"
  ],
  "parametros": {
    "jpeg": {
      "quality": [
        75,
        30
      ],
      "subsampling": 0,
      "optimize": false,
      "progressive": false
